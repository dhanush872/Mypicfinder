{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EventFrame: Launch Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_server.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "EventFrame: Fast Reload Server (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "EventFrame: Run Verification Checks & Package ZIP",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_checks.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "EventFrame: Create Photographer Admin",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/create_photographer.py",
      "args": [
        "--email", "admin@eventframe.com",
        "--password", "secret123",
        "--name", "Lead Photographer"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "EventFrame: Run Pytest Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    }
  ]
}
